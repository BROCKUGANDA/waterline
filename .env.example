# ─────────────────────────────────────────────────────────────────────────────
# WATERLINE — local development environment.
#
# This file is git-ignored. The template lives in .env.example; copy it and fill
# in the values rather than committing real ones — the PRD's secure-development
# controls (Part 10) require secret scanning with push protection, so a database
# password or signing key must never enter the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── System of record ─────────────────────────────────────────────────────────
# PostgreSQL 17, local instance. Not SQLite: the PRD's multi-tenancy model
# (Part 2.3) is enforced by Postgres row-level security, which SQLite has no
# equivalent of. The datasource and RLS policies are declared in prisma/.
DATABASE_URL="postgresql://app_user:app_dev@127.0.0.1:5432/waterline?schema=public"

# ── Field-level encryption (PRD Part 10) ─────────────────────────────────────
# Envelope encryption: a per-tenant data key (DEK) encrypts sensitive fields
# with AES-256-GCM; the DEK is itself wrapped by this key-encryption key (KEK).
# In production the KEK lives in an HSM-backed KMS and is never present in a
# lower environment — so this local value is a development-only KEK.
#
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CWL_FIELD_KEK_BASE64=""

# ── Identity (PRD Part 5.1, Part 10) ──────────────────────────────────────────
# HMAC key for session/refresh token integrity and webhook signature verification.
# Same rule: development-only, 32 bytes base64.
CWL_TOKEN_SECRET_BASE64=""

# OIDC issuer for UAE Pass / du SSO. Left blank locally, the auth layer runs in
# its documented development mode (see src/lib/auth.ts) and refuses to issue
# production tokens.
CWL_OIDC_ISSUER=""
CWL_OIDC_AUDIENCE="https://api.waterline.du"
CWL_UAE_PASS_AUTHORIZE_URL=""

# ── Event transport (PRD Part 6.3) ────────────────────────────────────────────
# When unset, the outbox relay publishes to the durable database-backed
# transport (topics + DLQ tables). Set to enable Kafka without a code change:
#   CWL_KAFKA_BROKERS="localhost:9092"
CWL_KAFKA_BROKERS=""

# ── Observability / operations ───────────────────────────────────────────────
# Surface the PID of the dev server in .zscripts/dev.pid
CWL_ENV="local"

# Set DEBUG_SQL=1 to log every Prisma query (development aid; off by default so
# tenant-identifying rows are not written to stdout).
DEBUG_SQL="0"